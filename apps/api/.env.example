NODE_ENV=development
DATABASE_URL=postgres://palier:palier@localhost:5433/palier
# Connections of the API's pool (5 when empty); an entry waiting on a busy lot holds one for up to 3 s.
DATABASE_POOL_MAX=5
HOST=127.0.0.1
PORT=3000
DEMO_MODE=true
STRIPE_SECRET_KEY=
# Connected test account (acct_…) of Stationnements Lavoie, written by the seed; empty keeps entry holds on the platform in demo mode.
DEMO_OPERATOR_STRIPE_ACCOUNT_ID=
# Signing secret (whsec_…) of the Stripe webhook endpoint /v1/stripe/webhook; `stripe listen --forward-to localhost:3000/v1/stripe/webhook` prints it. Empty serves no webhook.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends operators back after onboarding. Empty defaults to http://localhost:5173 in development and test.
DASHBOARD_URL=
MINIMUM_APP_VERSION=
# Seconds a barrier opening waits for the entry loop before the session is cancelled (at least 30), and seconds between cancellation checks.
# Window plus period must stay at or under 110 s, inside the app's 2-minute polling of the entry.
ENTRY_CONFIRMATION_WINDOW_SECONDS=60
ENTRY_CANCELLATION_PERIOD_SECONDS=30
# Seconds between checks that free the spot of a guarantee nobody used after its 15 minutes.
HOLD_EXPIRY_PERIOD_SECONDS=30
# Seconds between checks that presume parked a session silent for 30 minutes (entry confirmed, or a question never answered).
SILENT_SESSION_CHECK_PERIOD_SECONDS=300
# Test environments only (NODE_ENV development or test): unreachable makes every entry hold fail as if Stripe were down;
# success makes every hold succeed without calling Stripe (pi_sim_ intents), refused while STRIPE_SECRET_KEY is set.
PAYMENTS_SIMULATION=none
