{
  "name": "@palier/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/migrate/runMigrations.ts",
    "seed": "node --env-file-if-exists=.env src/seed/runSeed.ts",
    "seed:spot-state": "node --env-file-if-exists=.env src/seed/runSpotState.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.database.config.ts"
  },
  "dependencies": {
    "@palier/shared-types": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
