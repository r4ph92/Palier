{
  "name": "palier",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^24.3.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:api": "npm run test --workspace @palier/api",
    "test:mobile": "npm run test --workspace @palier/mobile",
    "db:migrate": "npm run db:migrate --workspace @palier/api",
    "gate": "npm run lint && npm run typecheck && npm run test:api && npm run test:mobile && npm run test:dashboard",
    "test:dashboard": "npm run test --workspace @palier/dashboard"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-dom": "19.3.0"
  }
}
